# Pinned upstream inputs. Every generated file under stone/ is derived from
# exactly these; scripts/build-carrier-bsp.sh --check proves it in CI.
#
# To move to a newer Avocado snapshot or ARK release: change the pin, run
# scripts/update-sources.sh (ARK/Linux pins) and/or
# scripts/build-carrier-bsp.sh (Avocado pin), review the diff, commit.

# Avocado feed that provides the jetson-orin-nx flash BSP (avocado-img-bootfiles).
# The DTBs, stock BCT files and flashvars we build on come from this package.
AVOCADO_REPO_URL=https://repo.avocadolinux.org
AVOCADO_RELEASE=2024
AVOCADO_CHANNEL=edge
AVOCADO_TARGET=jetson-orin-nx
AVOCADO_SNAPSHOT=17
# Feed packages are stored by content hash: <release>/<channel>/_pkgs/<aa>/<sha256>.rpm
BOOTFILES_SHA256=51a3cce53450cdf7c9e2dc9d6acb18f31876b6cbddb7c8ea19d16d9dd1779bff

# ARK Electronics' JAJ carrier sources (products/JAJ in ark_jetson_kernel), L4T R36.5.0.
ARK_REPO=https://github.com/ARK-Electronics/ark_jetson_kernel
ARK_COMMIT=93e5e97abbc5f34883018408070b4a82e9d5f25d

# Linux tree the dt-bindings headers under src/include/ come from.
LINUX_REPO=https://raw.githubusercontent.com/torvalds/linux
LINUX_TAG=v6.6
