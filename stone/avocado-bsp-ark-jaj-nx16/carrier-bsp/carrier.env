# Generated by scripts/build-carrier-bsp.sh from upstream.env. Do not edit.
# Consumed by stone-provision-tegraflash.sh: CARRIER_FV_* rewrite flashvars,
# CARRIER_ENV_* rewrite .env.initrd-flash.
CARRIER_LABEL="ARK Just A Jetson + Jetson Orin NX 16GB (P3767-0000), bsp-ark-jaj"

# JAJ kernel DTB (ARK carrier fragment + dual IMX219) for this SKU.
CARRIER_ENV_DTBFILE="tegra234-p3768-0000+p3767-0000-nv-super-ark-jaj.dtb"

# ARK's MB1 pinmux/GPIO (IMU spi3, UART-A flow control, ...) and MB2 misc
# with the carrier EEPROM read disabled.
CARRIER_FV_PINMUX_CONFIG="tegra234-mb1-bct-pinmux-p3767-dp-a03-ark-jaj.dtsi"
CARRIER_FV_MB2BCT_CFG="tegra234-mb2-bct-misc-p3767-0000-ark-jaj.dts"

# ARK's UEFI boot order: NVMe before USB, new devices (PXE/HTTP boot options)
# at the bottom. Appended so it wins over the stock L4TConfiguration.
CARRIER_FV_BOOTCONTROL_OVERLAYS="L4TConfiguration.dtbo,L4TConfiguration-RootfsRedundancyLevelABEnable.dtbo,ark-jaj-boot-order.dtbo"

# Refuse to flash any other module (tegraflash compares these to the EEPROM).
CARRIER_FV_CHECK_BOARDID="3767"
CARRIER_FV_CHECK_BOARDSKU="0000"
